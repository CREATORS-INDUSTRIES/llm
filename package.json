{
  "name": "@crtrs/llm",
  "version": "0.1.0",
  "description": "Run local AI models from Node with a small, comfortable API",
  "keywords": [
    "llm",
    "local",
    "ai",
    "gguf",
    "llama.cpp",
    "node-llama-cpp"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "usage": "npm run build && node usage.ts"
  },
  "dependencies": {
    "node-llama-cpp": "^3.22.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
